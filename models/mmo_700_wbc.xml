<?xml version='1.0' encoding='utf-8'?>
<mujoco model="mmo_700">
  <compiler angle="radian" meshdir="mmo_700/meshes" balanceinertia="true" />

  <!-- ===== DEFAULTS ===== -->
  <default>
    <!-- MMO-700 mobile base defaults -->
    <default class="robot">
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom contype="1" conaffinity="1" friction="0.7 0.005 0.0001" solref="0.04 1" solimp="0.9 0.95 0.001 0.5 2" />
      </default>
    </default>

    <!-- Floor default -->
    <default class="floor">
      <geom type="plane" size="20 20 0.05" material="groundplane" friction="0.8 0.005 0.0001" contype="1" conaffinity="1" />
    </default>
  </default>

  <!-- ===== ASSETS ===== -->
  <asset>
    <!-- Scene materials -->
    <material name="mount_grey"   rgba="0.7 0.7 0.7 1" />
    <material name="grey"         rgba="0.5 0.5 0.5 1" />
    <material name="black"        rgba="0.15 0.15 0.15 1" />
    <material name="wood"         rgba="0.60 0.40 0.20 1" specular="0.3" shininess="0.2" />
    <material name="red_box"      rgba="0.85 0.15 0.10 1" specular="0.5" shininess="0.5" />

    <!-- UR5e materials (menagerie-style) -->
    <material name="ur5e_black"    rgba="0.033 0.033 0.033 1" specular="0.5" shininess="0.25"/>
    <material name="ur5e_jointgray" rgba="0.278 0.278 0.278 1" specular="0.5" shininess="0.25"/>
    <material name="ur5e_linkgray"  rgba="0.820 0.820 0.820 1" specular="0.5" shininess="0.25"/>
    <material name="ur5e_urblue"    rgba="0.490 0.678 0.800 1" specular="0.5" shininess="0.25"/>


    <!-- Ground / sky textures -->
    <texture type="2d"      name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />

    <!-- MMO-700 base meshes -->
    <mesh name="base_link_mesh"  file="MPO-700-BODY.stl"          scale="0.001 0.001 0.001" />
    <mesh name="lidar_mesh"      file="SICK-S300.stl"             scale="0.001 0.001 0.001" />
    <mesh name="caster_mesh"     file="MPO-700-HEAD.stl"          scale="0.001 0.001 0.001" />
    <mesh name="wheel_mesh"      file="MPO-700-WHEEL.stl"         scale="0.001 0.001 0.001" />
    <mesh name="cabinet_mesh"    file="cabin.stl"                 scale="0.001 0.001 0.001" />
    <mesh name="dynamixel_motor"   file="cameras/dynamixel/dynamixel_motor_xl-430.stl"       scale="0.001 0.001 0.001" />
    <mesh name="dynamixel_bracket" file="cameras/dynamixel/dynamixel_bracket_fr12_h101.stl"  scale="0.001 0.001 0.001" />

    <!-- UR5e arm meshes (via ur5e_assets/ symlink in meshdir → mujoco_menagerie/universal_robots_ur5e/assets/) -->
    <mesh name="ur5e_base_0"     file="ur5e_assets/base_0.obj" />
    <mesh name="ur5e_base_1"     file="ur5e_assets/base_1.obj" />
    <mesh name="ur5e_shoulder_0" file="ur5e_assets/shoulder_0.obj" />
    <mesh name="ur5e_shoulder_1" file="ur5e_assets/shoulder_1.obj" />
    <mesh name="ur5e_shoulder_2" file="ur5e_assets/shoulder_2.obj" />
    <mesh name="ur5e_upperarm_0" file="ur5e_assets/upperarm_0.obj" />
    <mesh name="ur5e_upperarm_1" file="ur5e_assets/upperarm_1.obj" />
    <mesh name="ur5e_upperarm_2" file="ur5e_assets/upperarm_2.obj" />
    <mesh name="ur5e_upperarm_3" file="ur5e_assets/upperarm_3.obj" />
    <mesh name="ur5e_forearm_0"  file="ur5e_assets/forearm_0.obj" />
    <mesh name="ur5e_forearm_1"  file="ur5e_assets/forearm_1.obj" />
    <mesh name="ur5e_forearm_2"  file="ur5e_assets/forearm_2.obj" />
    <mesh name="ur5e_forearm_3"  file="ur5e_assets/forearm_3.obj" />
    <mesh name="ur5e_wrist1_0"   file="ur5e_assets/wrist1_0.obj" />
    <mesh name="ur5e_wrist1_1"   file="ur5e_assets/wrist1_1.obj" />
    <mesh name="ur5e_wrist1_2"   file="ur5e_assets/wrist1_2.obj" />
    <mesh name="ur5e_wrist2_0"   file="ur5e_assets/wrist2_0.obj" />
    <mesh name="ur5e_wrist2_1"   file="ur5e_assets/wrist2_1.obj" />
    <mesh name="ur5e_wrist2_2"   file="ur5e_assets/wrist2_2.obj" />
    <mesh name="ur5e_wrist3"     file="ur5e_assets/wrist3.obj" />

    <!-- D405 wrist camera meshes -->
    <mesh name="wrist_d405_mount"        file="cameras/d405/UR5_LastJointSensor_D405_Psyonic.STL" scale="0.001 0.001 0.001" />
    <mesh name="wrist_camera_link_d405"  file="cameras/d405/d405.stl"                             scale="0.001 0.001 0.001" />
  </asset>

  <!-- ===== VISUAL OPTIONS ===== -->
  <visual>
    <global offwidth="3840" offheight="2160" />
    <rgba haze="0.15 0.25 0.35 1" />
  </visual>

  <!-- ===== SIMULATION OPTIONS ===== -->
  <!-- elliptic friction cones + impratio 10 (as in MuJoCo Menagerie's Robotiq 2F-85 scene):
       with the default pyramidal cones / impratio 1 a friction grasp slowly slips and drops the object -->
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast" iterations="50" tolerance="1e-10"
          cone="elliptic" impratio="10" />

  <!-- ===== WORLD BODY ===== -->
  <worldbody>
    <light pos="0 0 3"   dir="0 0 -1" directional="true" />
    <light pos="2.0 0 2.5" dir="0 0 -1" directional="false" diffuse="0.6 0.6 0.5" specular="0.3 0.3 0.3" />

    <!-- Floor -->
    <geom name="floor" type="plane" size="50 50 0.05" material="groundplane"
          friction="0.8 0.005 0.0001" contype="1" conaffinity="1" solref="0.04 1" solimp="0.9 0.95 0.001 0.5 2" />

    <!-- ===== TABLE ===== -->
    <body name="table" pos="2.0 0 0">
      <geom name="table_top"    type="box"      size="0.40 0.35 0.025" pos="0 0 0.775"            material="wood" contype="1" conaffinity="1" />
      <geom name="table_leg_fl" type="cylinder" size="0.025 0.375"     pos=" 0.35  0.30 0.375"    material="wood" contype="1" conaffinity="1" />
      <geom name="table_leg_fr" type="cylinder" size="0.025 0.375"     pos=" 0.35 -0.30 0.375"    material="wood" contype="1" conaffinity="1" />
      <geom name="table_leg_bl" type="cylinder" size="0.025 0.375"     pos="-0.35  0.30 0.375"    material="wood" contype="1" conaffinity="1" />
      <geom name="table_leg_br" type="cylinder" size="0.025 0.375"     pos="-0.35 -0.30 0.375"    material="wood" contype="1" conaffinity="1" />
      <!-- Skirting frame around bottom (ensures 2D LiDAR ray detection) -->
      <geom name="table_skirt_front" type="box" size="0.02 0.35 0.20" pos="-0.38 0 0.20" material="wood" contype="1" conaffinity="1" />
      <geom name="table_skirt_rear"  type="box" size="0.02 0.35 0.20" pos=" 0.38 0 0.20" material="wood" contype="1" conaffinity="1" />
      <geom name="table_skirt_left"  type="box" size="0.38 0.02 0.20" pos="0  0.33 0.20" material="wood" contype="1" conaffinity="1" />
      <geom name="table_skirt_right" type="box" size="0.38 0.02 0.20" pos="0 -0.33 0.20" material="wood" contype="1" conaffinity="1" />
    </body>

    <!-- ===== TARGET DYNAMIC BALL ===== -->
    <body name="target_box" pos="2.05 -0.25 0.825">
      <freejoint name="box_joint" />
      <geom name="box_geom" type="sphere" size="0.025" material="red_box" mass="0.05" friction="1.5 0.01 0.001" contype="1" conaffinity="1" />
    </body>

    <!-- ===== MMO-700 MOBILE BASE ===== -->
    <body name="base_link" childclass="robot" pos="0 0 -0.01">
      <joint name="base_x" type="slide" axis="1 0 0" />
      <joint name="base_y" type="slide" axis="0 1 0" />
      <joint name="base_yaw" type="hinge" axis="0 0 1" />

      <!-- Base collision geometry (contype=1 so it collides with floor, table, obstacles) -->
      <geom name="base_link_collision" quat="0.7071 0 0 -0.7071" type="mesh" mesh="base_link_mesh"
            contype="1" conaffinity="1" friction="0.7 0.005 0.0001" solref="0.04 1" solimp="0.9 0.95 0.001 0.5 2" />
      <geom name="base_link_visual"    quat="0.7071 0 0 -0.7071" type="mesh" mesh="base_link_mesh"
            material="mount_grey" class="visual" />

      <!-- IMU site on base for accelerometer and gyroscope sensors -->
      <site name="base_imu_site" pos="0 0 0.3" size="0.01" rgba="1 0 0 0.3" group="4" />

      <!-- Front LiDAR (SICK S300 — front-right corner) -->
      <body name="lidar_1_link" pos="0.338 0.288 0.223" quat="0.0007 0.923 0.3848 0.0003">
        <geom name="lidar_1_visual" pos="0 0 -0.12" quat="0.0006 -0.0006 -0.7068 0.7074"
              type="mesh" mesh="lidar_mesh" material="mount_grey" class="visual" />
        <!-- Rangefinder site pointing in local forward direction (+X in world) -->
        <site name="lidar_front_site" pos="0 0 0" quat="0.7075 -0.5020 0.4974 0" size="0.005" group="4" />
      </body>

      <!-- Rear LiDAR (SICK S300 — rear-left corner) -->
      <body name="lidar_2_link" pos="-0.338 -0.288 0.223" quat="-0.0003 -0.3841 0.9233 0.0007">
        <geom name="lidar_2_visual" pos="0 0 -0.12" quat="0.0006 -0.0006 -0.7068 0.7074"
              type="mesh" mesh="lidar_mesh" material="mount_grey" class="visual" />
        <!-- Rangefinder site pointing in local rearward direction (-X in world) -->
        <site name="lidar_rear_site" pos="0 0 0" quat="0.7075 -0.5013 0.4982 0" size="0.005" group="4" />
      </body>

      <!-- Front-left caster wheel -->
      <body name="caster_fl" pos="0.24 0.18 0.22">
        <joint name="caster_fl_joint" type="hinge" axis="0 0 1" damping="5.0" frictionloss="2.0" />
        <geom type="mesh" mesh="caster_mesh" pos="0 0 0.10" class="visual" material="mount_grey" />
        <body name="wheel_fl" pos="0.0 0.045 -0.12">
          <joint name="wheel_fl_joint" type="hinge" axis="0 1 0" damping="0.2" />
          <geom type="mesh" mesh="wheel_mesh" class="visual" material="black" />
          <geom type="cylinder" size="0.09 0.03" quat="0.7071 0.7071 0 0" class="collision" />
        </body>
      </body>

      <!-- Front-right caster wheel -->
      <body name="caster_fr" pos="0.24 -0.18 0.22">
        <joint name="caster_fr_joint" type="hinge" axis="0 0 1" damping="5.0" frictionloss="2.0" />
        <geom type="mesh" mesh="caster_mesh" pos="0 0 0.10" class="visual" material="mount_grey" />
        <body name="wheel_fr" pos="0.0 -0.045 -0.12">
          <joint name="wheel_fr_joint" type="hinge" axis="0 1 0" damping="0.2" />
          <geom type="mesh" mesh="wheel_mesh" class="visual" material="black" />
          <geom type="cylinder" size="0.09 0.03" quat="0.7071 0.7071 0 0" class="collision" />
        </body>
      </body>

      <!-- Rear-left caster wheel -->
      <body name="caster_bl" pos="-0.24 0.18 0.22">
        <joint name="caster_bl_joint" type="hinge" axis="0 0 1" damping="5.0" frictionloss="2.0" />
        <geom type="mesh" mesh="caster_mesh" pos="0 0 0.10" class="visual" material="mount_grey" />
        <body name="wheel_bl" pos="0.0 0.045 -0.12">
          <joint name="wheel_bl_joint" type="hinge" axis="0 1 0" damping="0.2" />
          <geom type="mesh" mesh="wheel_mesh" class="visual" material="black" />
          <geom type="cylinder" size="0.09 0.03" quat="0.7071 0.7071 0 0" class="collision" />
        </body>
      </body>

      <!-- Rear-right caster wheel -->
      <body name="caster_br" pos="-0.24 -0.18 0.22">
        <joint name="caster_br_joint" type="hinge" axis="0 0 1" damping="5.0" frictionloss="2.0" />
        <geom type="mesh" mesh="caster_mesh" pos="0 0 0.10" class="visual" material="mount_grey" />
        <body name="wheel_br" pos="0.0 -0.045 -0.12">
          <joint name="wheel_br_joint" type="hinge" axis="0 1 0" damping="0.2" />
          <geom type="mesh" mesh="wheel_mesh" class="visual" material="black" />
          <geom type="cylinder" size="0.09 0.03" quat="0.7071 0.7071 0 0" class="collision" />
        </body>
      </body>

      <!-- ===== CABINET / TORSO ===== -->
      <body name="cabinet_link" pos="0.072 0 0.35">
        <inertial pos="0 0 0" quat="0.7071 0 0 -0.7071" mass="10.0" diaginertia="0.45 0.23 0.68" />
        <!-- Cabinet has only visual geometry so it doesn't interfere with arm collisions -->
        <geom name="cabinet_link_visual" quat="0.7071 0 0 -0.7071" type="mesh" mesh="cabinet_mesh"
              material="mount_grey" class="visual" />

        <!-- ===================================================
             UR5e ARM  (menagerie kinematics + collision capsules)
             Mounted at top of cabinet.
             pos="0.133 0.0 0.416" relative to cabinet_link.
             quat identity → arm's local +X faces robot forward (+X).
             The arm naturally reaches in the +X direction of the robot.
             =================================================== -->
        <body name="ur5e_base" pos="0.133 0.0 0.416" quat="1 0 0 0">
          <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
          <!-- Visual meshes (menagerie multi-obj style) -->
          <geom type="mesh" mesh="ur5e_base_0" material="ur5e_black"    contype="0" conaffinity="0" group="2"/>
          <geom type="mesh" mesh="ur5e_base_1" material="ur5e_jointgray" contype="0" conaffinity="0" group="2"/>

          <!-- Shoulder link -->
          <body name="shoulder_link" pos="0 0 0.1625">
            <inertial mass="3.7" pos="0 0 0" diaginertia="0.0102675 0.0102675 0.00666"/>
            <joint name="shoulder_pan_joint" type="hinge" range="-6.28319 6.28319"
                   axis="0 0 1" armature="0.1" damping="40"/>
            <geom type="mesh" mesh="ur5e_shoulder_0" material="ur5e_urblue"    contype="0" conaffinity="0" group="2"/>
            <geom type="mesh" mesh="ur5e_shoulder_1" material="ur5e_black"     contype="0" conaffinity="0" group="2"/>
            <geom type="mesh" mesh="ur5e_shoulder_2" material="ur5e_jointgray" contype="0" conaffinity="0" group="2"/>
            <!-- Collision capsule -->
            <geom type="capsule" size="0.06 0.06" pos="0 0 -0.04"
                  contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>

            <!-- Upper arm link -->
            <body name="upper_arm_link" pos="0 0.138 0" quat="1 0 1 0">
              <inertial mass="8.393" pos="0 0 0.2125" diaginertia="0.133886 0.133886 0.0151074"/>
              <joint name="shoulder_lift_joint" type="hinge" range="-6.28319 6.28319"
                     axis="0 1 0" armature="0.1" damping="40"/>
              <geom type="mesh" mesh="ur5e_upperarm_0" material="ur5e_linkgray"  contype="0" conaffinity="0" group="2"/>
              <geom type="mesh" mesh="ur5e_upperarm_1" material="ur5e_black"     contype="0" conaffinity="0" group="2"/>
              <geom type="mesh" mesh="ur5e_upperarm_2" material="ur5e_jointgray" contype="0" conaffinity="0" group="2"/>
              <geom type="mesh" mesh="ur5e_upperarm_3" material="ur5e_urblue"    contype="0" conaffinity="0" group="2"/>
              <!-- Collision capsules: shoulder joint + upper arm shaft -->
              <geom type="capsule" pos="0 -0.04 0" quat="1 1 0 0" size="0.06 0.06"
                    contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>
              <geom type="capsule" size="0.05 0.2" pos="0 0 0.2"
                    contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>

              <!-- Forearm link -->
              <body name="forearm_link" pos="0 -0.131 0.425">
                <inertial mass="2.275" pos="0 0 0.196" diaginertia="0.0311796 0.0311796 0.004095"/>
                <joint name="elbow_joint" type="hinge" range="-3.14159 3.14159"
                       axis="0 1 0" armature="0.1" damping="20"/>
                <geom type="mesh" mesh="ur5e_forearm_0" material="ur5e_urblue"    contype="0" conaffinity="0" group="2"/>
                <geom type="mesh" mesh="ur5e_forearm_1" material="ur5e_linkgray"  contype="0" conaffinity="0" group="2"/>
                <geom type="mesh" mesh="ur5e_forearm_2" material="ur5e_black"     contype="0" conaffinity="0" group="2"/>
                <geom type="mesh" mesh="ur5e_forearm_3" material="ur5e_jointgray" contype="0" conaffinity="0" group="2"/>
                <!-- Collision capsules: elbow joint + forearm shaft -->
                <geom type="capsule" pos="0 0.08 0" quat="1 1 0 0" size="0.055 0.06"
                      contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>
                <geom type="capsule" size="0.038 0.19" pos="0 0 0.2"
                      contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>

                <!-- Wrist 1 -->
                <body name="wrist_1_link" pos="0 0 0.392" quat="1 0 1 0">
                  <inertial mass="1.219" pos="0 0.127 0" diaginertia="0.0025599 0.0025599 0.0021942"/>
                  <joint name="wrist_1_joint" type="hinge" range="-6.28319 6.28319"
                         axis="0 1 0" armature="0.1" damping="10"/>
                  <geom type="mesh" mesh="ur5e_wrist1_0" material="ur5e_black"     contype="0" conaffinity="0" group="2"/>
                  <geom type="mesh" mesh="ur5e_wrist1_1" material="ur5e_urblue"    contype="0" conaffinity="0" group="2"/>
                  <geom type="mesh" mesh="ur5e_wrist1_2" material="ur5e_jointgray" contype="0" conaffinity="0" group="2"/>
                  <geom type="capsule" pos="0 0.05 0" quat="1 1 0 0" size="0.04 0.07"
                        contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>

                  <!-- Wrist 2 -->
                  <body name="wrist_2_link" pos="0 0.127 0">
                    <inertial mass="1.219" pos="0 0 0.1" diaginertia="0.0025599 0.0025599 0.0021942"/>
                    <joint name="wrist_2_joint" type="hinge" range="-6.28319 6.28319"
                           axis="0 0 1" armature="0.1" damping="10"/>
                    <geom type="mesh" mesh="ur5e_wrist2_0" material="ur5e_black"     contype="0" conaffinity="0" group="2"/>
                    <geom type="mesh" mesh="ur5e_wrist2_1" material="ur5e_urblue"    contype="0" conaffinity="0" group="2"/>
                    <geom type="mesh" mesh="ur5e_wrist2_2" material="ur5e_jointgray" contype="0" conaffinity="0" group="2"/>
                    <geom type="capsule" size="0.04 0.06" pos="0 0 0.04"
                          contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>
                    <geom type="capsule" pos="0 0.02 0.1" quat="1 1 0 0" size="0.04 0.04"
                          contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>

                    <!-- Wrist 3 (flange) -->
                    <body name="wrist_3_link" pos="0 0 0.1">
                      <inertial mass="0.1889" pos="0 0.0771683 0" quat="1 0 0 1"
                                diaginertia="0.000132134 9.90863e-05 9.90863e-05"/>
                      <joint name="wrist_3_joint" type="hinge" range="-6.28319 6.28319"
                             axis="0 1 0" armature="0.1" damping="10"/>
                      <geom type="mesh" mesh="ur5e_wrist3" material="ur5e_linkgray" contype="0" conaffinity="0" group="2"/>
                      <geom type="cylinder" pos="0 0.08 0" quat="1 1 0 0" size="0.04 0.02"
                            contype="1" conaffinity="1" group="3" rgba="0.4 0.4 0.4 0.3"/>

                      <!-- Tool flange (UR tool0, menagerie convention: z out of the flange). The hand / gripper
                           (steve_grasping: Dex5-1 or Robotiq 2F-85) is attached here when the model is
                           loaded (steve_grasping.robot_model.compose), with its grasp point site `pinch`. -->
                      <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0" size="0.002" group="5"/>
                      <body name="hand_mount" pos="0 0.1 0" quat="-1 1 0 0" />

                      <!-- D405 Wrist Camera -->
                      <body name="wrist_d405_mount" pos="0.0 0.1 0.0" quat="-0.5 0.5 0.5 0.5">
                        <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001" />
                        <geom name="wrist_d405_mount_collision" type="box" size="0.01 0.045 0.0125" contype="1" conaffinity="1" />
                        <geom name="wrist_d405_mount_visual"    type="mesh" mesh="wrist_d405_mount" material="grey" contype="0" conaffinity="0" group="2" />
                        <body name="wrist_camera_link" pos="0.079 0.0 0.047" quat="0 0.6088 0 0.7934">
                          <inertial pos="0 0 0" mass="0.06" diaginertia="0.0001 0.0001 0.0001" />
                          <geom name="wrist_camera_link_collision" type="box" size="0.0125 0.045 0.0115" contype="1" conaffinity="1" />
                          <geom name="wrist_camera_link_visual"    pos="0.01 0 0.01" quat="0.7074 0 0.7068 0"
                                type="mesh" mesh="wrist_camera_link_d405" material="grey" contype="0" conaffinity="0" group="2" />
                          <!-- Wrist camera rendering camera -->
                          <!-- Wrist camera: quat verified to give 0° error pointing at gripper pinch.
                               cam_xmat = body_xmat @ R_cam, solved for desired look = cam->pinch.
                               quat(w,x,y,z) = -0.3189 0 0.9478 0 in wrist_camera_link frame. -->
                          <camera name="wrist_cam" pos="0.0 0.0 0.0" quat="-0.3189 0.0 0.9478 0.0" fovy="69" />
                          <body name="wrist_camera_color_frame">
                            <body name="wrist_camera_color_optical_frame" quat="0.5 -0.5 0.5 -0.5" />
                          </body>
                        </body>
                      </body>
                    </body><!-- /wrist_3_link -->
                  </body><!-- /wrist_2_link -->
                </body><!-- /wrist_1_link -->
              </body><!-- /forearm_link -->
            </body><!-- /upper_arm_link -->
          </body><!-- /shoulder_link -->
        </body><!-- /ur5e_base -->

        <!-- Pan-tilt camera tower (on cabinet top) -->
        <!-- NOTE: Kept inside cabinet_link so it rides with the torso, -->
        <!-- but placed at a pos that locates it on the robot body box.  -->

      </body><!-- /cabinet_link -->

      <!-- Pan-tilt camera tower — direct child of base_link so it
           sits on the mobile base, independent of the arm/cabinet. -->
      <body name="pan_tilt_tower_base" pos="-0.15 0 1.1">
        <geom type="box" size="0.015 0.015 0.45" material="mount_grey" class="visual" />
        <body name="pan_tilt_tilt_motor_base_link" pos="0 0 0.4855" quat="-0.5 -0.5 -0.5 -0.5">
          <geom type="mesh" mesh="dynamixel_motor" material="mount_grey" class="visual" />
          <body name="pan_tilt_tilt_motor_link">
            <!-- axis sign matches the URDF (Gazebo / real robot): same angle, same head motion -->
            <joint name="pan_tilt_tilt_motor_joint" type="hinge" range="-3.14 0.35" axis="1 0 0" damping="0.1" />
            <body name="pan_tilt_tilt_bracket_link" quat="0.7297 0.6838 0 0">
              <geom type="mesh" mesh="dynamixel_bracket" material="mount_grey" class="visual" />
              <body name="pan_tilt_pan_motor_base_link" pos="0 0.0633 0" quat="0.7071 0 0.7071 0">
                <geom type="mesh" mesh="dynamixel_motor" material="mount_grey" class="visual" />
                <body name="pan_tilt_pan_motor_link">
                  <joint name="pan_tilt_pan_motor_joint" type="hinge" range="-3.14 0.35" axis="-1 0 0" damping="0.1" />
                  <body name="pan_tilt_pan_bracket_link" quat="0.0325 0.9995 0 0">
                    <geom type="mesh" mesh="dynamixel_bracket" material="mount_grey" class="visual" />
                    <!-- Camera head: cylinder visual + rendering camera. Pose = URDF
                         pan_tilt_camera_link (Gazebo / real robot); body +z = viewing axis. -->
                    <body name="pan_tilt_camera_link" pos="-0.0067 -0.0397 -0.0026" quat="-0.5 -0.5 0.5314 -0.4665">
                      <geom type="cylinder" size="0.0305 0.013" material="grey" class="visual" />
                      <!-- Pan-tilt rendering camera at the URDF optical frame (+0.01 z), looking
                           along body +z with image up = world up -->
                      <camera name="pan_tilt_cam" pos="0 0 0.01" quat="0 1 0 0" fovy="60" />
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body><!-- /pan_tilt_tower_base -->

    </body><!-- /base_link -->
  </worldbody>

  <!-- ===== CONTACT EXCLUSIONS ===== -->
  <contact>
    <!-- Base vs. its own children -->
    <exclude body1="base_link" body2="cabinet_link" />
    <exclude body1="base_link" body2="caster_fl" />
    <exclude body1="base_link" body2="caster_fr" />
    <exclude body1="base_link" body2="caster_bl" />
    <exclude body1="base_link" body2="caster_br" />
    <exclude body1="base_link" body2="wheel_fl" />
    <exclude body1="base_link" body2="wheel_fr" />
    <exclude body1="base_link" body2="wheel_bl" />
    <exclude body1="base_link" body2="wheel_br" />
    <exclude body1="caster_fl" body2="wheel_fl" />
    <exclude body1="caster_fr" body2="wheel_fr" />
    <exclude body1="caster_bl" body2="wheel_bl" />
    <exclude body1="caster_br" body2="wheel_br" />

    <!-- UR5e arm adjacent-link exclusions -->
    <exclude body1="cabinet_link"   body2="ur5e_base" />
    <exclude body1="ur5e_base"      body2="shoulder_link" />
    <exclude body1="shoulder_link"  body2="upper_arm_link" />
    <exclude body1="upper_arm_link" body2="forearm_link" />
    <exclude body1="forearm_link"   body2="wrist_1_link" />
    <exclude body1="wrist_1_link"   body2="wrist_2_link" />
    <exclude body1="wrist_2_link"   body2="wrist_3_link" />
  </contact>

  <!-- ===== ACTUATORS ===== -->
  <actuator>
    <!-- Base actuators (Kinematic & Dynamic) -->
    <motor name="base_x_motor" joint="base_x" />
    <motor name="base_y_motor" joint="base_y" />
    <motor name="base_yaw_motor" joint="base_yaw" />
    <velocity name="base_x_vel" joint="base_x" kv="1000" />
    <velocity name="base_y_vel" joint="base_y" kv="1000" />
    <velocity name="base_yaw_vel" joint="base_yaw" kv="1000" />

    <!-- Arm Dynamic (Motor) Actuators -->
    <motor name="shoulder_pan_motor" joint="shoulder_pan_joint" ctrlrange="-150 150" />
    <motor name="shoulder_lift_motor" joint="shoulder_lift_joint" ctrlrange="-150 150" />
    <motor name="elbow_motor" joint="elbow_joint" ctrlrange="-150 150" />
    <motor name="wrist_1_motor" joint="wrist_1_joint" ctrlrange="-28 28" />
    <motor name="wrist_2_motor" joint="wrist_2_joint" ctrlrange="-28 28" />
    <motor name="wrist_3_motor" joint="wrist_3_joint" ctrlrange="-28 28" />

    <!-- Arm Kinematic (Velocity) Actuators -->
    <velocity name="shoulder_pan_vel" joint="shoulder_pan_joint" kv="100" />
    <velocity name="shoulder_lift_vel" joint="shoulder_lift_joint" kv="100" />
    <velocity name="elbow_vel" joint="elbow_joint" kv="100" />
    <velocity name="wrist_1_vel" joint="wrist_1_joint" kv="100" />
    <velocity name="wrist_2_vel" joint="wrist_2_joint" kv="100" />
    <velocity name="wrist_3_vel" joint="wrist_3_joint" kv="100" />
  </actuator>

  <!-- ===== SENSORS ===== -->
  <sensor>
    <!-- IMU on robot base -->
    <accelerometer name="base_accel" site="base_imu_site" />
    <gyro          name="base_gyro"  site="base_imu_site" />

    <!-- LiDAR rangefinders (using existing SICK S300 body sites) -->
    <rangefinder name="front_lidar" site="lidar_front_site" />
    <rangefinder name="rear_lidar"  site="lidar_rear_site" />

    <!-- Wheel velocity feedback -->
    <jointvel name="wheel_fl_vel_sensor" joint="wheel_fl_joint" />
    <jointvel name="wheel_fr_vel_sensor" joint="wheel_fr_joint" />
    <jointvel name="wheel_bl_vel_sensor" joint="wheel_bl_joint" />
    <jointvel name="wheel_br_vel_sensor" joint="wheel_br_joint" />

    <!-- UR5e arm joint positions -->
    <jointpos name="shoulder_pan_pos"  joint="shoulder_pan_joint" />
    <jointpos name="shoulder_lift_pos" joint="shoulder_lift_joint" />
    <jointpos name="elbow_pos"         joint="elbow_joint" />
    <jointpos name="wrist_1_pos"       joint="wrist_1_joint" />
    <jointpos name="wrist_2_pos"       joint="wrist_2_joint" />
    <jointpos name="wrist_3_pos"       joint="wrist_3_joint" />

    <!-- UR5e arm joint velocities -->
    <jointvel name="shoulder_pan_vel"  joint="shoulder_pan_joint" />
    <jointvel name="shoulder_lift_vel" joint="shoulder_lift_joint" />
    <jointvel name="elbow_vel"         joint="elbow_joint" />
    <jointvel name="wrist_1_vel"       joint="wrist_1_joint" />
    <jointvel name="wrist_2_vel"       joint="wrist_2_joint" />
    <jointvel name="wrist_3_vel"       joint="wrist_3_joint" />
  </sensor>


</mujoco>