<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>steve_wbc</name>
  <version>1.0.0</version>
  <description>Unified velocity-level (kinematic) whole-body controller for Steve (MMO-700 base + UR5e arm): figure-8 EE tracking in MuJoCo, Gazebo and on the real robot</description>
  <maintainer email="nakhyeshrikar@icloud.com">ItsShriks</maintainer>
  <license>MIT</license>

  <!-- ROS interfaces used by the controller -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Python dependencies (mujoco is not in rosdep: pip install mujoco) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <!-- Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>steve_simulation</exec_depend>
  <exec_depend>steve_navigation</exec_depend>
  <exec_depend>steve_manipulation</exec_depend>
  <!-- VGN grasp detection (bridge, worker, weights) -->
  <exec_depend>steve_perception</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
